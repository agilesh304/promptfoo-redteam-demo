# ─── API Keys ───────────────────────────────────────────────────────────────
# Set whichever key(s) you have. The app auto-selects the first one present.
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Target App Config ───────────────────────────────────────────────────────
# Which prompt version to use: "v1" (weak) or "v2" (hardened)
PROMPT_VERSION=v1

# Port for the target Flask server
APP_PORT=5001

# ─── Model Selection ─────────────────────────────────────────────────────────
# Model used for the TARGET (the app under test) — keep cheap
TARGET_MODEL=groq:llama-3.1-8b-instant

# Model used for GRADING / red-team generation — can be stronger
GRADER_MODEL=groq:llama-3.3-70b-versatile
